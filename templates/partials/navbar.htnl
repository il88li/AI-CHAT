<header class="nav" id="nav" role="banner">
  <a class="nav-brand" href="/" aria-label="خَيال — الرئيسية">
    <span class="brand-mark" aria-hidden="true">خ</span>
    <span>خَيال</span>
  </a>

  <nav class="nav-links" aria-label="التنقل الرئيسي">
    <a class="nav-link" href="#features">المميزات</a>
    <a class="nav-link" href="#how">كيف تعمل</a>
    <a class="nav-link" href="#community">المجتمع</a>
  </nav>

  <div class="nav-grow"></div>

  <div class="nav-actions">
    <label class="search" aria-label="بحث">
      <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
      <input
        type="search"
        id="searchInput"
        placeholder="ابحث…"
        autocomplete="off"
        inputmode="search"
        aria-label="ابحث في البرومبتات">
      <div class="search-results" id="searchResults" data-open="false" role="listbox" aria-label="نتائج البحث"></div>
    </label>

    <button
      class="btn btn-icon btn-ghost"
      onclick="App.toggleTheme()"
      aria-label="تبديل المظهر"
      type="button">
      <i class="ph ph-moon" id="themeIcon" aria-hidden="true"></i>
    </button>

    <button
      class="btn btn-secondary btn-sm"
      id="signInBtn"
      onclick="Auth.open('login')"
      type="button">
      <i class="ph ph-sign-in" aria-hidden="true"></i>
      <span>دخول</span>
    </button>

    <button
      class="btn btn-icon btn-ghost"
      id="avatarBtn"
      onclick="App.switchTab('profile')"
      aria-label="حسابي"
      type="button"
      hidden>
      <img class="avatar avatar-sm" id="avatarImg" src="" alt="">
    </button>
  </div>
</header>